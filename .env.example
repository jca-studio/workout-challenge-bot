# Required
DISCORD_TOKEN=paste-your-bot-token-here

# Where the scores live. On Railway, mount a volume at /data and keep this as is.
DATABASE_PATH=/data/challenge.db

# Time zone for reminders, missions, the Friday lock and Saturday standings
TIMEZONE=America/New_York
REMINDER_HOUR=20
MISSION_POST_HOUR=7
STANDINGS_HOUR=9

# Rules the group is still deciding
# optional | required | per_goal
PHOTO_MODE=optional
TEAM_MODE_MIN_PLAYERS=8
# compare teams by average per player
TEAM_SCORE_AVERAGE=true
TEAM_NAMES=Bad Bitches,Muscle Mamis

# Mini missions
MISSION_WEEKLY_CAP=0
PERFECT_WEEK_BONUS=1
# chance a Random Mix-Up mission replaces the day's theme
MIXUP_CHANCE=0.15

# Roles handed out at the end
WINNER_ROLE_NAME=Challenge Champion
TOP_SCORER_ROLE_NAME=That Girl

# Winner nicknames get an emoji until the next challenge ends
CROWN_NICKNAMES=true
WINNER_EMOJI=👑
TOP_SCORER_EMOJI=💎
